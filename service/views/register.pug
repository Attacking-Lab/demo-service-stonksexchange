extends layout

block content
  .card.card--auth
    h1.card-title Register
    p.muted Create a new account to start trading stonks.
    form(role='form', action='/register', method='post')
      .form-group
        label(for='user') Username
        input.form-control(type='text', id='user', name='username', placeholder='enter your username', autocomplete='username')
      .form-group
        label(for='password') Password
        input.form-control(type='password', id='password', name='password', placeholder='enter your password', autocomplete='new-password')
      .form-actions
        button.btn.btn-primary.btn-block(type='submit') Create account
